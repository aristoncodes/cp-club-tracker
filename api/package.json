{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "wrangler types && tsc -p .",
    "test": "vitest run",
    "db:local": "rm -rf .wrangler/state && wrangler d1 migrations apply cp-tracker --local",
    "db:seed": "wrangler d1 execute cp-tracker --local --file seed.dev.sql",
    "dev": "wrangler dev --test-scheduled"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
